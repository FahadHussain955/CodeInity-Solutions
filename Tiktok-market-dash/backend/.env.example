# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ──────────────────────────────────────────────
# PostgreSQL (Prisma)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora?schema=public

# ──────────────────────────────────────────────
# JWT (prepared for Phase 3 — auth)
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────
# Uploads (Multer — configure only)
# ──────────────────────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=5
