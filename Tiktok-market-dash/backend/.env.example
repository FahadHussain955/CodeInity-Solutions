# ──────────────────────────────────────────────
# Nexora Backend — Environment Template
# Copy to backend/.env and fill placeholders.
# NEVER commit real secrets.
# ──────────────────────────────────────────────

# ══════════════════════════════════════════════
# SERVER
# ══════════════════════════════════════════════
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ══════════════════════════════════════════════
# DATABASE (REQUIRED NOW)
# ══════════════════════════════════════════════
# Local Postgres is often on 5433; Docker compose may use 5432.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/nexora?schema=public

# ══════════════════════════════════════════════
# AUTHENTICATION / JWT (REQUIRED NOW)
# Production: random strings, min 32 characters, not the change_me defaults.
# ══════════════════════════════════════════════
JWT_SECRET=your-secret-here-min-32-chars________
JWT_EXPIRES_IN=15m
JWT_ACCESS_SECRET=your-secret-here-min-32-chars________
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32______
JWT_REFRESH_EXPIRES_IN=7d

# ══════════════════════════════════════════════
# FRONTEND URL / CORS (REQUIRED NOW)
# Must match the SPA origin (Vite local or Vercel).
# ══════════════════════════════════════════════
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ══════════════════════════════════════════════
# GOOGLE OAUTH (REQUIRED FOR GOOGLE LOGIN ONLY)
# https://console.cloud.google.com/apis/credentials
# Redirect URI must equal GOOGLE_CALLBACK_URL exactly.
# Leave blank to disable Google Sign-In (email auth still works).
# Client Secret stays on the backend — never VITE_*.
# ══════════════════════════════════════════════
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ══════════════════════════════════════════════
# GEMINI AI (OPTIONAL — heuristic fallback if empty)
# https://aistudio.google.com/apikey
# Backend ONLY.
# ══════════════════════════════════════════════
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ══════════════════════════════════════════════
# CLOUDINARY (OPTIONAL locally; recommended in production)
# https://console.cloudinary.com/
# Backend ONLY. Falls back to local UPLOAD_DIR if empty.
# ══════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══════════════════════════════════════════════
# UPLOADS (local fallback when Cloudinary unset)
# ══════════════════════════════════════════════
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# ══════════════════════════════════════════════
# RATE LIMITING (OPTIONAL knobs)
# ══════════════════════════════════════════════
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=40

# ══════════════════════════════════════════════
# BACKGROUND JOBS (OPTIONAL)
# ══════════════════════════════════════════════
JOBS_ENABLED=true

# ══════════════════════════════════════════════
# SEED ADMIN (optional — used by npm run seed)
# ══════════════════════════════════════════════
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=Admin1234!

# ══════════════════════════════════════════════
# SHOPIFY / TIKTOK PARTNER / STRIPE / EMAIL
# ══════════════════════════════════════════════
# No environment variables are read by the current implementation.
# Shopify connect is blocked as "coming soon".
# TikTok Shop uses sandbox sync (optional user-supplied token in UI only).
# Stripe billing and email delivery are not implemented.
# Do not add invented keys until those features are coded.
