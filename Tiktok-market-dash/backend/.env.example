# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ──────────────────────────────────────────────
# PostgreSQL (Prisma)
# ──────────────────────────────────────────────
# Local PostgreSQL 18 default port is often 5433 (5432 may be an older install)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/nexora?schema=public

# ──────────────────────────────────────────────
# JWT (Nexora session — used after local & Google login)
# Prefer JWT_SECRET; JWT_ACCESS_SECRET kept for compatibility.
# ──────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars_long_secure
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=change_me_jwt_secret_min_32_chars_long_secure
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Frontend / CORS
# ──────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────
# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
# Leave blank to disable Google login (API returns a clear error).
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ──────────────────────────────────────────────
# Uploads (Multer)
# ──────────────────────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=5
