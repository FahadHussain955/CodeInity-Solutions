// Nexora Prisma schema — Auth + Inventory + Customers (Phase 6 & 7)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  local
  google
}

enum Role {
  user
  admin
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELLED
  UNDER_REVIEW
  REFUNDED
}

enum StockAdjustmentType {
  RESTOCK
  ADJUSTMENT
  SALE
  RESERVE
  RELEASE
  OUT_OF_STOCK
  BULK
}

enum IntegrationProvider {
  SHOPIFY
  TIKTOK_SHOP
  WOOCOMMERCE
}

enum SyncStatus {
  IDLE
  PENDING
  SYNCING
  SUCCESS
  FAILED
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  email             String             @unique
  password          String?
  avatar            String?
  avatarPublicId    String?
  phone             String?
  provider          AuthProvider       @default(local)
  providerId        String?
  role              Role               @default(user)
  isEmailVerified   Boolean            @default(false)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stockMovements    StockMovement[]
  storeIntegrations StoreIntegration[]
  syncLogs          SyncLog[]
  aiInsightCaches   AiInsightCache[]
  settings          UserSettings?
  notifications     Notification[]
  activityLogs      ActivityLog[]
  loginHistory      LoginHistory[]
  refreshSessions   RefreshSession[]
  products          Product[]
  customers         Customer[]
  orders            Order[]
  campaigns         Campaign[]
  audiences         Audience[]
  refunds           Refund[]

  @@unique([provider, providerId])
  @@index([deletedAt])
  @@map("users")
}

model StoreIntegration {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     IntegrationProvider
  storeName    String
  storeUrl     String
  storeId      String?
  accessToken  String?
  refreshToken String?
  isConnected  Boolean             @default(true)
  lastSyncAt   DateTime?
  syncStatus   SyncStatus          @default(IDLE)
  syncProgress Int                 @default(0)
  syncMessage  String?
  metadata     Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  syncLogs     SyncLog[]

  @@unique([userId, provider, storeUrl])
  @@index([userId, isConnected])
  @@index([provider])
  @@map("store_integrations")
}

model SyncLog {
  id            String           @id @default(cuid())
  integrationId String
  integration   StoreIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        SyncStatus
  progress      Int              @default(0)
  message       String?
  details       Json?
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@index([integrationId, createdAt])
  @@index([userId, createdAt])
  @@map("sync_logs")
}

model Product {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  sku            String          @unique
  category       String
  price          Decimal         @db.Decimal(12, 2)
  costPrice      Decimal?        @db.Decimal(12, 2)
  image          String?
  description    String?
  status         ProductStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventory      Inventory?
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([sku])
  @@index([status])
  @@index([userId])
  @@map("products")
}

model Inventory {
  id              String          @id @default(cuid())
  productId       String          @unique
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentStock    Int             @default(0)
  reservedStock   Int             @default(0)
  reorderLevel    Int             @default(10)
  maxStockLevel   Int             @default(1000)
  lastRestockedAt DateTime?
  lastMovementAt  DateTime?
  warehouse       String?         @default("Main Warehouse")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  movements       StockMovement[]

  @@index([currentStock])
  @@index([updatedAt])
  @@map("inventory")
}

model StockMovement {
  id             String               @id @default(cuid())
  inventoryId    String
  inventory      Inventory            @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  previousQty    Int
  newQty         Int
  adjustmentType StockAdjustmentType
  reason         String?
  userId         String?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())

  @@index([productId, createdAt])
  @@index([inventoryId, createdAt])
  @@map("stock_movements")
}

model Customer {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  email             String
  phone             String?
  profileImage      String?
  address           String?
  city              String?
  state             String?
  postalCode        String?
  country           String?        @default("Pakistan")
  totalOrders       Int            @default(0)
  totalSpent        Decimal        @default(0) @db.Decimal(14, 2)
  averageOrderValue Decimal        @default(0) @db.Decimal(12, 2)
  lastOrderDate     DateTime?
  status            CustomerStatus @default(ACTIVE)
  tags              String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  orders            Order[]

  @@unique([userId, email])
  @@index([userId])
  @@index([fullName])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([lastOrderDate])
  @@index([createdAt])
  @@index([totalSpent])
  @@map("customers")
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderNumber   String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status        OrderStatus @default(PENDING)
  paymentMethod String?
  totalAmount   Decimal     @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  refunds       Refund[]

  @@index([userId])
  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@index([userId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal? @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(14, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/**
 * Financial refund against an order.
 * MVP: refunds adjust net revenue/profit; they do NOT restore inventory
 * unless a future return workflow is added (see PRODUCT_PROFITABILITY_DOCUMENTATION).
 */
model Refund {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 2)
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([orderId])
  @@index([orderId, createdAt])
  @@index([userId, createdAt])
  @@map("refunds")
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  UNDER_REVIEW
  DRAFT
}

enum CampaignObjective {
  CONVERSIONS
  TRAFFIC
  AWARENESS
}

enum CreativeStatus {
  ACTIVE
  PAUSED
  UNDER_REVIEW
  REJECTED
}

enum AudienceStatus {
  READY
  POPULATING
  ARCHIVED
}

enum AudienceType {
  INTEREST
  LOOKALIKE
  CUSTOM
}

model Campaign {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  code         String             @unique
  campaignName String
  objective    CampaignObjective  @default(CONVERSIONS)
  platform     String             @default("TikTok")
  status       CampaignStatus     @default(DRAFT)
  budget       Decimal            @db.Decimal(14, 2)
  dailyBudget  Decimal?           @db.Decimal(14, 2)
  totalSpend   Decimal            @default(0) @db.Decimal(14, 2)
  impressions  Int                @default(0)
  clicks       Int                @default(0)
  ctr          Decimal            @default(0) @db.Decimal(8, 4)
  cpc          Decimal            @default(0) @db.Decimal(10, 4)
  cpm          Decimal            @default(0) @db.Decimal(10, 4)
  conversions  Int                @default(0)
  revenue      Decimal            @default(0) @db.Decimal(14, 2)
  roas         Decimal            @default(0) @db.Decimal(10, 2)
  startDate    DateTime?
  endDate      DateTime?
  adGroups     Int                @default(0)
  targeting    Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  creatives    AdCreative[]
  audiences    CampaignAudience[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([platform])
  @@index([campaignName])
  @@index([createdAt])
  @@map("campaigns")
}

model AdCreative {
  id           String         @id @default(cuid())
  code         String         @unique
  campaignId   String
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title        String
  mediaUrl     String?
  mediaType    String         @default("In-Feed Video")
  duration     String?
  thumbnail    String?
  caption      String?
  adGroup      String?
  reviewStatus CreativeStatus @default(UNDER_REVIEW)
  impressions  Int            @default(0)
  clicks       Int            @default(0)
  ctr          Decimal        @default(0) @db.Decimal(8, 4)
  conversions  Int            @default(0)
  spend        Decimal        @default(0) @db.Decimal(14, 2)
  roas         Decimal        @default(0) @db.Decimal(10, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([campaignId])
  @@index([reviewStatus])
  @@index([title])
  @@map("ad_creatives")
}

model Audience {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  code           String         @unique
  audienceName   String
  type           AudienceType   @default(INTEREST)
  gender         String?
  ageRange       String?
  countries      String[]       @default([])
  interests      String[]       @default([])
  estimatedReach String?
  reachMin       Int?
  reachMax       Int?
  status         AudienceStatus @default(READY)
  source         String?
  matchScore     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  campaigns      CampaignAudience[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([audienceName])
  @@index([status])
  @@index([type])
  @@map("audiences")
}

model CampaignAudience {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audienceId String
  audience   Audience @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, audienceId])
  @@map("campaign_audiences")
}

model AiInsightCache {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cacheKey  String
  payload   Json
  provider  String   @default("gemini")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cacheKey])
  @@index([expiresAt])
  @@map("ai_insight_caches")
}

enum NotificationType {
  ORDER
  INVENTORY
  AI
  SYNC
  CAMPAIGN
  SYSTEM
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName             String   @default("Nexora TikTok Shop")
  storeUrl              String   @default("nexora.tiktok.com")
  businessName          String?
  contactEmail          String?
  contactPhone          String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  country               String?  @default("Pakistan")
  timezone              String   @default("Asia/Karachi")
  currency              String   @default("USD")
  description           String?
  emailNotifications    Boolean  @default(true)
  lowStockAlerts        Boolean  @default(true)
  orderNotifications    Boolean  @default(true)
  campaignNotifications Boolean  @default(true)
  aiNotifications       Boolean  @default(true)
  customerNotifications Boolean  @default(false)
  marketingEmails       Boolean  @default(true)
  planName              String   @default("Growth")
  planStatus            String   @default("Active")
  planRenewsAt          DateTime?
  usageSeats            Int      @default(1)
  usageOrders           Int      @default(0)
  usageStorageMb        Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("user_settings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  meta      Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  message   String
  icon      String?  @default("history")
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_history")
}

model RefreshSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("refresh_sessions")
}
