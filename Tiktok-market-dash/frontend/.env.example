# ──────────────────────────────────────────────
# Nexora Frontend (Vite) — Environment Template
# Copy to frontend/.env OR project-root .env
# Anything here is PUBLIC in the browser bundle.
# ──────────────────────────────────────────────

# ══════════════════════════════════════════════
# API (REQUIRED NOW)
# ══════════════════════════════════════════════
# Must include the /api/v1 prefix used by the Express app.
VITE_API_URL=http://localhost:5000/api/v1

# Production example:
# VITE_API_URL=https://your-api.up.railway.app/api/v1

# ══════════════════════════════════════════════
# DO NOT PUT SECRETS HERE
# ══════════════════════════════════════════════
# Never add:
# - JWT_SECRET / JWT_REFRESH_SECRET
# - GOOGLE_CLIENT_SECRET
# - GEMINI_API_KEY
# - CLOUDINARY_API_SECRET
# - DATABASE_URL
# - Shopify / TikTok client secrets
#
# Google OAuth starts on the backend (/api/v1/auth/google).
# No VITE_GOOGLE_* variables are used by the current code.
